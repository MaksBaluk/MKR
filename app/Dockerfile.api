FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.9.4 /uv /uvx /usr/local/bin/
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 UV_LINK_MODE=copy
WORKDIR /code
RUN useradd --uid 10001 --create-home cmapp
COPY pyproject.toml .python-version ./
# Without a committed uv.lock, first build resolves project dependencies and creates one inside the image.
RUN uv sync --no-dev --python /usr/local/bin/python3.12
COPY alembic.ini ./
COPY alembic ./alembic
COPY backend ./backend
COPY fixtures ./fixtures
COPY scripts ./scripts
RUN chown -R cmapp:cmapp /code
USER cmapp
ENV PATH="/code/.venv/bin:${PATH}"
EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
