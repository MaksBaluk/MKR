# LOCAL RESEARCH DEMO ONLY. Do not use or publish these demo credentials in production.
APP_NAME=CompetenceMatch
APP_ENV=development
POSTGRES_DB=competencematch
POSTGRES_USER=cm_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD
DATABASE_URL=postgresql+psycopg://cm_app:REPLACE_WITH_STRONG_APP_PASSWORD@localhost:5432/competencematch
DEMO_MODE=true
DEMO_EMAIL=demo@competencematch.local
DEMO_PASSWORD=REPLACE_WITH_STRONG_DEMO_PASSWORD
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# To enable AI: set provider and model for your account, paste a key here, restart the API.
# LLM_PROVIDER=anthropic | openai_compatible | disabled
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=18
LLM_QUESTION_GENERATION=true
# hybrid: objective test first, generated scenario on second question about same skill.
# dynamic: generate each question as open-ended; review required for evidence.
LLM_QUESTION_STRATEGY=hybrid
LLM_QUESTION_REPHRASING=false
